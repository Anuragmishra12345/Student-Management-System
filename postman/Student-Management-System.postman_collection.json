{
  "info": {
    "name": "Student Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD API validation for Student Management System backend"
  },
  "item": [
    {
      "name": "Create Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Anurag Mishra\",\n  \"email\": \"anurag@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "Get All Students",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "Get Student By Id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        }
      }
    },
    {
      "name": "Update Student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Anurag Mishra\",\n  \"email\": \"anurag.updated@example.com\",\n  \"course\": \"Software Engineering\",\n  \"age\": 21\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        }
      }
    },
    {
      "name": "Delete Student",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}
